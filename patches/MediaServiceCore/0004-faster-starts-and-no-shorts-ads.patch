+                // After the current fetch, never in parallel with another one (shared state)
+                synchronized (FormatFetchLock.LOCK) {
+                    if (mCachedTranslationLanguages != null && mCachedTranslationLanguages.size() >= 100) {
+                        return;
+                    }
+
+                    boolean oldUseAuth = mUseAuth;
+                    mUseAuth = false;
+                    try {

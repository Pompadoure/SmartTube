+    private void fetchTranslationLanguagesInBackground(String videoId, String clickTrackingParams) {
+        if (System.currentTimeMillis() - mTranslationFetchTimeMs < 10 * 60 * 1_000 || !mTranslationFetchRunning.compareAndSet(false, true)) {
+            return;

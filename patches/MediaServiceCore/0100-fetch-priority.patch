@@ -1,12 +1,79 @@
 package com.liskovsoft.youtubeapi.service.internal;
 
+import java.util.concurrent.Callable;
+import java.util.concurrent.atomic.AtomicInteger;
+
 /**
  * JoTube: one stream info fetch at a time. VideoInfoService, PoTokenGate, the decipher in AppService and the
  * single cached info share state that isn't thread safe; parallel fetches mixed it up (streams failed with 403).
+ * <p>
+ * Priority: a foreground fetch (the video the user waits for) goes before background fetches that haven't
+ * started yet. The monitor stays a plain one: a foreground fetch counts itself in FOREGROUND_ACTIVE from before it
+ * takes the monitor until it is done, background fetches call {@link #beforeLock()} before they take the monitor
+ * and wait (bounded, holding nothing) while the counter is above zero. A running fetch is never interrupted.
  */
 public final class FormatFetchLock {
     public static final Object LOCK = new Object();
 
+    private static final long BACKGROUND_POLL_MS = 50;
+    private static final long BACKGROUND_MAX_WAIT_MS = 4_000; // a background fetch is never starved for good
+
+    private static final AtomicInteger FOREGROUND_ACTIVE = new AtomicInteger();
+    // Set by the caller around the blocking call (the Rx callable runs on an io thread, one fetch per thread)
+    private static final ThreadLocal<Boolean> FOREGROUND = new ThreadLocal<>();
+
     private FormatFetchLock() {
     }
+
+    /**
+     * Marks the fetches made by the current thread inside {@code callable} as foreground.
+     */
+    public static <T> T callForeground(Callable<T> callable) throws Exception {
+        Boolean old = FOREGROUND.get();
+        FOREGROUND.set(true);
+        try {
+            return callable.call();
+        } finally {
+            if (old == null) {
+                FOREGROUND.remove();
+            } else {
+                FOREGROUND.set(old);
+            }
+        }
+    }
+
+    /**
+     * Call right before {@code synchronized (LOCK)}, and pass the result to {@link #afterFetch(boolean)} in a finally.
+     * Foreground: registers itself and returns true at once. Background: waits (bounded) while a foreground
+     * fetch is registered, returns false.
+     */
+    public static boolean beforeLock() {
+        if (Boolean.TRUE.equals(FOREGROUND.get())) {
+            FOREGROUND_ACTIVE.incrementAndGet();
+            return true;
+        }
+
+        awaitForeground();
+        return false;
+    }
+
+    public static void afterFetch(boolean foreground) {
+        if (foreground) {
+            FOREGROUND_ACTIVE.decrementAndGet();
+        }
+    }
+
+    /**
+     * Background fetches: let foreground fetches take the monitor first. Holds no lock while waiting.
+     */
+    public static void awaitForeground() {
+        long deadline = System.currentTimeMillis() + BACKGROUND_MAX_WAIT_MS;
+        try {
+            while (FOREGROUND_ACTIVE.get() > 0 && System.currentTimeMillis() < deadline) {
+                Thread.sleep(BACKGROUND_POLL_MS);
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt(); // disposed: carry on, the interrupt flag stays set
+        }
+    }
 }

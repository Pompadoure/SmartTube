+    /**
+     * JoTube: the reel requests go out signed in when there's an account, so YouTube shapes the feed by the account's
+     * history. If a signed-in request gives nothing (or fails with a non-network error) and the anonymous one works,
+     * signed-in reel requests are off for the rest of the run (the extra round trip happens at most once).
+     */
+    private fun <T> withShortsAuth(what: String, isEmpty: (T?) -> Boolean, request: (Boolean) -> T?): T? {
+        if (!isShortsSignedIn()) {
+            Log.d(SHORTS_TAG, if (sShortsAuthBroken.get()) "Shorts feed: anonymous (fallback) [%s]" else "Shorts feed: anonymous (not signed in) [%s]", what)
+            return request(false)
+        }
+
+        val signed: T? = try {
+            request(true)
+        } catch (e: Exception) {
+            if (e is IllegalStateException && e.cause is IOException) {
+                throw e // network problem: the caller handles it as before
+            }
+            Log.e(SHORTS_TAG, "Shorts feed: signed-in request failed [%s]: %s", what, e.message)
+            null
+        }
+
+        if (!isEmpty(signed)) {
+            Log.d(SHORTS_TAG, "Shorts feed: signed-in [%s]", what)
+            return signed
+        }
+
+        if (Thread.currentThread().isInterrupted) {
+            return null // cancelled, not a failure
+        }
+
+        val anonymous = request(false)
+
+        if (!isEmpty(anonymous)) {
+            if (sShortsAuthBroken.compareAndSet(false, true)) {
+                Log.w(SHORTS_TAG, "Shorts feed: signed-in reel requests return nothing, anonymous for the rest of the run")
+            }
+            Log.d(SHORTS_TAG, "Shorts feed: anonymous (fallback) [%s]", what)
+        }
+
+        return anonymous
+    }

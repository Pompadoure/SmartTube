+private val sShortsAuthBroken = AtomicBoolean(false)
+
+// JoTube: seeded new feeds that gave nothing in a row (then the usual feed only, no extra round trips)
+private val sShortsSeedFailures = AtomicInteger(0)
+private const val SHORTS_SEED_MAX_FAILURES = 2
+
+// JoTube: the own sequence token and the reel params of the Shorts loaded in the feed (videoId -> seed)
+private class ShortsSeed(val token: String?, val params: String?)
+
+private const val SHORTS_SEEDS_MAX = 500
+
+private val sShortsSeeds = object : LinkedHashMap<String, ShortsSeed>(64, 0.75f, true) {
+    override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, ShortsSeed>?): Boolean {
+        return size > SHORTS_SEEDS_MAX
+    }
+}
+
+private fun rememberShortsSeed(videoId: String?, token: String?, params: String?) {
+    if (videoId == null || (token == null && params == null)) {
+        return
+    }
+
+    synchronized(sShortsSeeds) {
+        sShortsSeeds[videoId] = ShortsSeed(token, params)
+    }
+}
+
+private fun getShortsSeed(videoId: String?): ShortsSeed? {
+    if (videoId == null) {
+        return null
+    }
+
+    synchronized(sShortsSeeds) {
+        return sShortsSeeds[videoId]
+    }
+}

+    /** JoTube: the signed-in reel request with its HTTP status in the log (why does YouTube give nothing?). */
+    private fun getShortsSignedInLogged(call: retrofit2.Call<ReelResult?>): ReelResult? {
+        val response = RetrofitHelper.getResponse(call)
+        if (response == null) {
+            Log.d(SHORTS_TAG, "Shorts feed: signed-in reel request: no response")
+            return null
+        }
+        val body = response.body()
+        if (body == null) {
+            val err = try { response.errorBody()?.string()?.take(300) } catch (e: Exception) { null }
+            Log.w(SHORTS_TAG, "Shorts feed: signed-in reel request: HTTP %s, no body: %s", response.code(), err)
+        } else if (body.getVideoId() == null) {
+            Log.w(SHORTS_TAG, "Shorts feed: signed-in reel request: HTTP %s, a body without a Short", response.code())
+        }
+        return body
+    }

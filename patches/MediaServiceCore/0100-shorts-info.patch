@@ -0,0 +1,37 @@
+package com.liskovsoft.youtubeapi.app.nsigsolver.common
+
+/**
+ * JoTube: the solver V8 runtimes are kept alive between format info fetches (re-creating them and parsing
+ * the player took most of the time of every fetch). This frees them again when nothing used them for a while.
+ *
+ * [onIdle] is called with the owner's lock held and must dispose the runtime (if any).
+ */
+internal class IdleReaper(private val lock: Any, private val idleMs: Long, private val onIdle: () -> Unit) {
+    @Volatile private var lastUseMs = 0L
+    private var thread: Thread? = null
+
+    /** Call under [lock] after each use of the runtime */
+    fun touch() {
+        lastUseMs = System.currentTimeMillis()
+        if (thread == null) {
+            thread = Thread({
+                while (true) {
+                    try {
+                        Thread.sleep(idleMs / 2)
+                    } catch (e: InterruptedException) {
+                        break
+                    }
+                    synchronized(lock) {
+                        if (System.currentTimeMillis() - lastUseMs >= idleMs) {
+                            try {
+                                onIdle()
+                            } catch (e: Exception) {
+                                e.printStackTrace()
+                            }
+                        }
+                    }
+                }
+            }, "JoTubeSolverReaper").also { it.isDaemon = true; it.start() }
+        }
+    }
+}

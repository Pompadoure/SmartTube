<?xml version="1.0" encoding="utf-8"?>
<!-- JoTube: YouTube-style sidebar item. The pill background and the colors are animated by IconHeaderItemPresenter. -->
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/sidebar_item_height"
    android:minWidth="@dimen/sidebar_item_width"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/sidebar_item_padding"
    android:paddingEnd="@dimen/sidebar_item_padding"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/header_icon"
        android:layout_width="@dimen/sidebar_icon_size"
        android:layout_height="@dimen/sidebar_icon_size"
        android:scaleType="fitCenter"
        android:contentDescription="@string/header_icon" />

    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
        android:id="@+id/header_label"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sidebar_icon_gap"

        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:ellipsize="marquee"
        android:scrollHorizontally="true"

        style="@style/TextAppearance.Leanback.Header"
        android:textSize="@dimen/sidebar_text_size"
        android:fontFamily="@font/roboto_medium"
        android:includeFontPadding="false"/>
</androidx.leanback.widget.NonOverlappingLinearLayout>

<resources>
    <style name="Mobile.Theme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/yt_bg</item>
        <item name="android:colorBackground">@color/yt_bg</item>
        <item name="android:statusBarColor">@color/yt_bg</item>
        <item name="android:navigationBarColor">@color/yt_bg</item>
        <item name="android:textColorPrimary">@color/yt_text</item>
        <item name="android:textColorSecondary">@color/yt_text_secondary</item>
        <item name="android:colorAccent">@color/yt_red</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Mobile.Theme.Splash" parent="Mobile.Theme">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Mobile.Theme.Dialog" parent="Mobile.Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
</resources>
